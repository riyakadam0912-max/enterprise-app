// Activity Timeline models
// Used by: src/activity-timeline/activity-timeline.service.ts
// ─────────────────────────────────────────────────────────────────────────────

model ActivityTimeline {
  id              Int                       @id @default(autoincrement())
  module          String
  entityType      String
  entityId        Int
  eventType       String
  action          String
  title           String
  description     String?
  oldValue        Json?
  newValue        Json?
  metadata        Json?
  performedBy     Int?
  performedByRole String?
  assignedTo      Int?
  status          String                    @default("OPEN")
  priority        String                    @default("MEDIUM")
  icon            String?
  color           String?
  ipAddress       String?
  deviceInfo      String?
  attachments     Json?
  workflowStage   String?
  approvalStatus  String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  organizationId        Int

  comments        ActivityTimelineComment[]
  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([entityType, entityId])
  @@index([module])
  @@index([eventType])
  @@index([performedBy])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([organizationId])
}

model ActivityTimelineComment {
  id              Int              @id @default(autoincrement())
  timelineId      Int
  userId          Int?
  userRole        String?
  comment         String
  parentCommentId Int?
  mentions        Json?
  isInternal      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  organizationId        Int

  timeline        ActivityTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([timelineId])
  @@index([userId])
  @@index([organizationId])
}


