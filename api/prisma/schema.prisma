generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int              @id @default(autoincrement())
  name                    String
  email                   String           @unique
  password                String
  role                    Role
  isActive                Boolean          @default(true)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  employeeId              Int?             @unique
  deletedAt               DateTime?
  organizationId          Int?
  address                 String?
  managerId               Int?
  phone                   String?
  refreshToken            String?
  activities              Activity[]
  hrApprovedExpenses      Expense[]        @relation("ExpenseHrApprovedBy")
  managerApprovedExpenses Expense[]        @relation("ExpenseManagerApprovedBy")
  submittedExpenses       Expense[]        @relation("ExpenseSubmittedBy")
  uploadedFiles           File[]           @relation("FileUploadedBy")
  invoices                Invoice[]
  ledgerEntries           LedgerEntry[]
  notificationsCreated    Notification[]
  managedProjects         Project[]        @relation("ProjectManager")
  projectLinksCreated     ProjectLink[]
  sentMessages            ProjectMessage[] @relation("ProjectMessageSender")
  createdTasks            Task[]           @relation("TaskAssignedBy")
  assignedTasks           Task[]           @relation("TaskAssignedTo")
  reviewedTasks           Task[]           @relation("TaskReviewedBy")
  employee                Employee?        @relation("UserEmployee", fields: [employeeId], references: [id])
  manager                 User?            @relation("UserManager", fields: [managerId], references: [id])
  teamMembers             User[]           @relation("UserManager")
  organization            Organization?    @relation(fields: [organizationId], references: [id])
  userRoles               UserRole[]
  coManagedProjects       Project[]        @relation("ProjectCoManagers")

  @@index([organizationId])
}

model AppRole {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Organization {
  id                       Int                       @id @default(autoincrement())
  name                     String
  code                     String                    @unique
  slug                     String                    @unique
  email                    String?
  phone                    String?
  logoUrl                  String?
  address                  String?
  city                     String?
  state                    String?
  country                  String?
  postalCode               String?
  timezone                 String                    @default("UTC")
  currency                 String                    @default("USD")
  status                   OrganizationStatus        @default(ACTIVE)
  website                  String?
  gstNumber                String?
  panNumber                String?
  taxId                    String?
  industry                 String?
  employeeLimit            Int?
  subscriptionPlan         String?
  billingEmail             String?
  billingAddress           String?
  contactPerson            String?
  contactPhone             String?
  contactEmail             String?
  trialStartDate           DateTime?
  trialEndDate             DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  activities               Activity[]
  activityTimelines        ActivityTimeline[]
  activityTimelineComments ActivityTimelineComment[]
  attendances              Attendance[]
  auditLogs                AuditLog[]
  campaignLeads            CampaignLead[]
  candidates               Candidate[]
  contacts                 Contact[]
  deals                    Deal[]
  dynamicForms             DynamicForm[]
  employees                Employee[]
  events                   Event[]
  expenses                 Expense[]
  files                    File[]
  fileActivities           FileActivity[]
  fileAttachments          FileAttachment[]
  form16s                  Form16[]
  formSubmissions          FormSubmission[]
  goals                    Goal[]
  goalCycles               GoalCycle[]
  importLogs               ImportLog[]
  interviews               Interview[]
  invoices                 Invoice[]
  jobOpenings              JobOpening[]
  leads                    Lead[]
  leaveRequests            LeaveRequest[]
  ledgerEntries            LedgerEntry[]
  marketingCampaigns       MarketingCampaign[]
  notifications            Notification[]
  notificationDeliveryLogs NotificationDeliveryLog[]
  notificationPreferences  NotificationPreference[]
  notificationRecipients   NotificationRecipient[]
  payments                 Payment[]
  payrollConfigs           PayrollConfig[]
  payrollCycles            PayrollCycle[]
  payrollDeductions        PayrollDeduction[]
  payrollEarnings          PayrollEarnings[]
  payrollEntries           PayrollEntry[]
  payslips                 Payslip[]
  performanceReviews       PerformanceReview[]
  products                 Product[]
  productCategories        ProductCategory[]
  projects                 Project[]
  projectLinks             ProjectLink[]
  projectMembers           ProjectMember[]
  projectMessages          ProjectMessage[]
  quotes                   Quote[]
  quoteItems               QuoteItem[]
  salaryStructures         SalaryStructure[]
  shifts                   Shift[]
  tasks                    Task[]
  taxDeclarations          TaxDeclaration[]
  tickets                  Ticket[]
  timesheets               Timesheet[]
  users                    User[]
  workflowActions          WorkflowAction[]
  workflowAssignments      WorkflowAssignment[]
  workflowComments         WorkflowComment[]
  workflowHistories        WorkflowHistory[]
  workflowInstances        WorkflowInstance[]
  workflowNotifications    WorkflowNotification[]
  workflowSteps            WorkflowStep[]

  @@index([status])
  @@index([createdAt])
  @@index([slug])
  @@index([code])
  @@index([subscriptionPlan])
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique
  description     String?
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         AppRole    @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())
  role      AppRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Employee {
  id                    Int                 @id @default(autoincrement())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  department            String?
  designation           String?
  email                 String?
  hireDate              DateTime?
  leaveBalance          Int?
  manager               String?
  name                  String
  phoneNumber           String?
  status                String?
  phone                 String?
  position              String?
  salary                Float?
  deletedAt             DateTime?
  organizationId        Int
  address               String?
  emergencyContact      String?
  emergencyContactPhone String?
  pan                   String?
  shiftId               Int?
  attendances           Attendance[]
  dealAssignments       Deal[]              @relation("DealAssignee")
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shift                 Shift?              @relation(fields: [shiftId], references: [id])
  expenseClaims         Expense[]
  form16s               Form16[]
  goals                 Goal[]
  leadAssignments       Lead[]              @relation("LeadAssignee")
  leaveRequests         LeaveRequest[]
  payrollEntries        PayrollEntry[]
  payslips              Payslip[]
  performanceReviews    PerformanceReview[]
  projectMemberships    ProjectMember[]
  salaryStructures      SalaryStructure[]
  taskAssignments       Task[]              @relation("TaskAssignee")
  taxDeclarations       TaxDeclaration[]
  user                  User?               @relation("UserEmployee")
  assignedProjects      Project[]           @relation("ProjectAssignedEmployees")

  @@index([organizationId])
}

model Shift {
  id                 Int          @id @default(autoincrement())
  name               String
  type               ShiftType
  startTime          String?
  endTime            String?
  requiredHours      Float        @default(8)
  gracePeriodMinutes Int          @default(15)
  rotationPattern    String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?
  organizationId     Int
  attendances        Attendance[]
  employees          Employee[]
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Attendance {
  id             Int              @id @default(autoincrement())
  employeeId     Int
  date           DateTime
  checkIn        DateTime?
  checkOut       DateTime?
  workingHours   Float?
  status         AttendanceStatus
  createdAt      DateTime         @default(now())
  shiftId        Int?
  deletedAt      DateTime?
  isAutoClosed   Boolean          @default(false)
  isPaidLeave    Boolean?
  lateMinutes    Int              @default(0)
  overtimeHours  Float            @default(0)
  remarks        String?
  requiredHours  Float?
  organizationId Int
  employee       Employee         @relation(fields: [employeeId], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shift          Shift?           @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@index([organizationId])
}

model Invoice {
  id             Int          @id @default(autoincrement())
  invoiceNo      String       @unique
  totalAmount    Float        @default(0)
  status         String       @default("DRAFT")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userId         Int
  customer       String?
  discount       Float        @default(0)
  dueDate        DateTime?
  issueDate      DateTime?
  notes          String?
  paymentMethod  String?
  taxAmount      Float        @default(0)
  deletedAt      DateTime?
  clientEmail    String?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])
  payments       Payment[]

  @@index([organizationId])
}

model LedgerEntry {
  id             Int          @id @default(autoincrement())
  date           DateTime?
  description    String?
  debit          Float        @default(0)
  credit         Float        @default(0)
  account        String?
  invoice        String?
  expense        String?
  balance        Float        @default(0)
  reference      String?
  userId         Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model Lead {
  id               Int            @id @default(autoincrement())
  name             String
  email            String?
  phone            String?
  status           String         @default("New")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  company          String?
  notes            String?
  source           String?
  assignedTo       String?
  contactedDate    DateTime?
  createdBy        String?
  leadOwner        String?
  leadScore        Int?
  nextFollowUp     DateTime?
  assignedToId     Int?
  deletedAt        DateTime?
  organizationId   Int
  activities       Activity[]
  campaignLeads    CampaignLead[]
  deals            Deal[]
  assignedEmployee Employee?      @relation("LeadAssignee", fields: [assignedToId], references: [id])
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks            Task[]

  @@index([organizationId])
}

model CampaignLead {
  id              Int          @id @default(autoincrement())
  campaign        String
  engagementScore Int?
  sourceType      String?
  lastInteraction DateTime?
  status          String       @default("NEW")
  notes           String?
  leadId          Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  organizationId  Int
  lead            Lead?        @relation(fields: [leadId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Timesheet {
  id             Int          @id @default(autoincrement())
  task           String
  project        String?
  date           DateTime
  hours          Float
  status         String       @default("PENDING")
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Deal {
  id               Int          @id @default(autoincrement())
  title            String
  value            Float
  stage            String       @default("NEW")
  probability      Float?
  closeDate        DateTime?
  leadId           Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  actualCloseDate  DateTime?
  contact          String?
  owner            String?
  pipeline         String?
  contactId        Int?
  assignedToId     Int?
  deletedAt        DateTime?
  organizationId   Int
  activities       Activity[]
  assignedEmployee Employee?    @relation("DealAssignee", fields: [assignedToId], references: [id])
  linkedContact    Contact?     @relation("ContactToDeals", fields: [contactId], references: [id])
  lead             Lead?        @relation(fields: [leadId], references: [id])
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotes           Quote[]
  tasks            Task[]

  @@index([organizationId])
}

model Task {
  id               Int          @id @default(autoincrement())
  status           String       @default("PENDING")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  actualHours      Float?
  assignee         String?
  dueDate          DateTime?
  estimatedHours   Float?
  notes            String?
  priority         String?
  project          String?
  taskName         String
  dealId           Int?
  leadId           Int?
  assignedToId     Int?
  submissionLink   String?
  reviewComment    String?
  deletedAt        DateTime?
  assignedByUserId Int?
  assignedToUserId Int?
  category         String?
  description      String?
  links            String?
  projectId        Int?
  reviewedAt       DateTime?
  reviewedBy       Int?
  submissionNotes  String?
  organizationId   Int
  assignedByUser   User?        @relation("TaskAssignedBy", fields: [assignedByUserId], references: [id])
  assignedEmployee Employee?    @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedToUser   User?        @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id])
  deal             Deal?        @relation(fields: [dealId], references: [id])
  lead             Lead?        @relation(fields: [leadId], references: [id])
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectRef       Project?     @relation("ProjectTasks", fields: [projectId], references: [id])
  reviewedByUser   User?        @relation("TaskReviewedBy", fields: [reviewedBy], references: [id])

  @@index([organizationId])
}

model LeaveRequest {
  id             Int          @id @default(autoincrement())
  startDate      DateTime
  endDate        DateTime
  leaveType      String
  reason         String?
  status         String       @default("PENDING")
  appliedOn      DateTime?
  approvedBy     String?
  approvalTrail  Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employeeId     Int?
  deletedAt      DateTime?
  isPaid         Boolean      @default(true)
  organizationId Int
  employee       Employee?    @relation(fields: [employeeId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model TicketType {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  color     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  tickets   Ticket[]
}

model Ticket {
  id             Int          @id @default(autoincrement())
  event          String?
  customer       String?
  price          Float?
  status         String       @default("RESERVED")
  purchaseDate   DateTime?
  qrCode         String?
  notes          String?
  ticketTypeId   Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketType     TicketType?  @relation(fields: [ticketTypeId], references: [id])

  @@index([organizationId])
}

model FormSubmission {
  id             Int          @id @default(autoincrement())
  form           String
  submittedBy    String?
  submissionDate DateTime?
  data           String?
  status         String       @default("SUBMITTED")
  reviewer       String?
  reviewDate     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model MarketingCampaign {
  id             Int          @id @default(autoincrement())
  campaignName   String
  channel        String?
  startDate      DateTime?
  endDate        DateTime?
  objective      String?
  budget         Float?
  status         String       @default("PLANNED")
  targetAudience String?
  createdBy      String?
  campaignOwner  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Expense {
  id                      Int          @id @default(autoincrement())
  expenseDate             DateTime?
  category                String?
  description             String?
  amount                  Float?
  currency                String?
  receiptImage            String?
  approvedBy              String?
  status                  String       @default("PENDING")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  employeeId              Int?
  submittedByUserId       Int?
  managerApprovalByUserId Int?
  hrApprovalByUserId      Int?
  approvedAt              DateTime?
  rejectedAt              DateTime?
  rejectionReason         String?
  approvalTrail           Json?
  deletedAt               DateTime?
  organizationId          Int
  employee                Employee?    @relation(fields: [employeeId], references: [id])
  hrApprovalByUser        User?        @relation("ExpenseHrApprovedBy", fields: [hrApprovalByUserId], references: [id])
  managerApprovalByUser   User?        @relation("ExpenseManagerApprovedBy", fields: [managerApprovalByUserId], references: [id])
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submittedByUser         User?        @relation("ExpenseSubmittedBy", fields: [submittedByUserId], references: [id])

  @@index([organizationId])
}

model Project {
  id                Int              @id @default(autoincrement())
  projectName       String
  projectCode       String?
  startDate         DateTime?
  endDate           DateTime?
  manager           String?
  status            String           @default("PLANNED")
  budget            Float?
  description       String?
  client            String?
  projectLead       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  managerId         Int?
  organizationId    Int
  managerUser       User?            @relation("ProjectManager", fields: [managerId], references: [id])
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  links             ProjectLink[]
  members           ProjectMember[]
  messages          ProjectMessage[]
  tasks             Task[]           @relation("ProjectTasks")
  assignedEmployees Employee[]       @relation("ProjectAssignedEmployees")
  coManagers        User[]           @relation("ProjectCoManagers")

  @@index([organizationId])
}

model ProjectMessage {
  id             String       @id @default(cuid())
  projectId      Int
  senderId       Int
  content        String
  createdAt      DateTime     @default(now())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id])
  sender         User         @relation("ProjectMessageSender", fields: [senderId], references: [id])

  @@index([projectId])
  @@index([senderId])
  @@index([organizationId])
}

model ProjectLink {
  id             Int          @id @default(autoincrement())
  projectId      Int
  title          String
  url            String
  createdById    Int
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  organizationId Int
  createdBy      User         @relation(fields: [createdById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([organizationId])
}

model ProjectMember {
  projectId      Int
  employeeId     Int
  role           String?
  joinedAt       DateTime     @default(now())
  organizationId Int
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, employeeId])
  @@index([organizationId])
}

model Contact {
  id             Int          @id @default(autoincrement())
  contactName    String
  email          String?
  phoneNumber    String?
  company        String?
  jobTitle       String?
  leadSource     String?
  address        String?
  website        String?
  linkedin       String?
  contactStatus  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organizationId Int
  activities     Activity[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals          Deal[]       @relation("ContactToDeals")
  quotes         Quote[]

  @@index([organizationId])
}

model Activity {
  id             Int          @id @default(autoincrement())
  type           ActivityType
  description    String
  userId         Int
  leadId         Int?
  dealId         Int?
  contactId      Int?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  organizationId Int
  contact        Contact?     @relation(fields: [contactId], references: [id])
  deal           Deal?        @relation(fields: [dealId], references: [id])
  lead           Lead?        @relation(fields: [leadId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model Event {
  id             Int          @id @default(autoincrement())
  eventName      String
  eventCode      String?
  startDateTime  DateTime?
  endDateTime    DateTime?
  location       String?
  organizer      String?
  status         String?
  capacity       Int?
  description    String?
  eventType      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model DynamicForm {
  id             Int          @id @default(autoincrement())
  formName       String
  formCode       String?
  description    String?
  createdBy      String?
  status         String?
  formType       String?
  targetModule   String?
  createdOn      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Quote {
  id             Int          @id @default(autoincrement())
  dealId         Int
  contactId      Int
  total          Float
  status         String       @default("DRAFT")
  validTill      DateTime
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organizationId Int
  contact        Contact      @relation(fields: [contactId], references: [id])
  deal           Deal         @relation(fields: [dealId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          QuoteItem[]

  @@index([organizationId])
}

model QuoteItem {
  id             Int          @id @default(autoincrement())
  quoteId        Int
  name           String
  quantity       Int
  price          Float
  deletedAt      DateTime?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote          Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model ProductCategory {
  id             Int          @id @default(autoincrement())
  name           String
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  organizationId Int
  products       Product[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Product {
  id             Int              @id @default(autoincrement())
  name           String
  description    String?
  price          Float
  sku            String?
  categoryId     Int?
  taxRate        Float?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?
  organizationId Int
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Payment {
  id             Int          @id @default(autoincrement())
  invoiceId      Int
  amount         Float
  paymentMethod  String
  transactionId  String?
  paymentDate    DateTime
  status         String
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  organizationId Int
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Notification {
  id             Int                       @id @default(autoincrement())
  title          String
  message        String
  createdAt      DateTime                  @default(now())
  actionUrl      String?
  category       String                    @default("SYSTEM")
  createdBy      Int?
  entityId       Int?
  entityType     String?
