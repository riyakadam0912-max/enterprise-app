generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int              @id @default(autoincrement())
  name                    String
  email                   String           @unique
  password                String
  role                    Role
  isActive                Boolean          @default(true)
  employeeId              Int?             @unique
  managerId               Int?
  organizationId          Int?
  phone                   String?
  address                 String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  refreshToken            String?
  deletedAt               DateTime?
  activities              Activity[]
  hrApprovedExpenses      Expense[]        @relation("ExpenseHrApprovedBy")
  managerApprovedExpenses Expense[]        @relation("ExpenseManagerApprovedBy")
  submittedExpenses       Expense[]        @relation("ExpenseSubmittedBy")
  uploadedFiles           File[]           @relation("FileUploadedBy")
  invoices                Invoice[]
  ledgerEntries           LedgerEntry[]
  notificationsCreated    Notification[]
  managedProjects         Project[]        @relation("ProjectManager")
  projectLinksCreated     ProjectLink[]
  sentMessages            ProjectMessage[] @relation("ProjectMessageSender")
  createdTasks            Task[]           @relation("TaskAssignedBy")
  assignedTasks           Task[]           @relation("TaskAssignedTo")
  reviewedTasks           Task[]           @relation("TaskReviewedBy")
  employee                Employee?        @relation("UserEmployee", fields: [employeeId], references: [id])
  manager                 User?            @relation("UserManager", fields: [managerId], references: [id])
  teamMembers             User[]           @relation("UserManager")
  coManagedProjects       Project[]        @relation("ProjectCoManagers")
  userRoles               UserRole[]
  organization            Organization?    @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model AppRole {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Organization {
  id                Int                 @id @default(autoincrement())
  name              String
  code              String              @unique
  slug              String              @unique
  email             String?
  phone             String?
  logoUrl           String?
  address           String?
  city              String?
  state             String?
  country           String?
  postalCode        String?
  timezone          String              @default("UTC")
  currency          String              @default("USD")
  status            OrganizationStatus  @default(ACTIVE)
  website           String?
  gstNumber         String?
  panNumber         String?
  taxId             String?
  industry          String?
  employeeLimit     Int?
  subscriptionPlan  String?
  billingEmail      String?
  billingAddress    String?
  contactPerson     String?
  contactPhone      String?
  contactEmail      String?
  trialStartDate    DateTime?
  trialEndDate      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  users             User[]
  employees         Employee[]
  shifts            Shift[]
  attendances       Attendance[]
  invoices          Invoice[]
  ledgerEntries     LedgerEntry[]
  leads             Lead[]
  campaignLeads     CampaignLead[]
  timesheets        Timesheet[]
  deals             Deal[]
  tasks             Task[]
  leaveRequests     LeaveRequest[]
  tickets           Ticket[]
  formSubmissions   FormSubmission[]
  marketingCampaigns MarketingCampaign[]
  expenses          Expense[]
  projects          Project[]
  projectMessages   ProjectMessage[]
  projectLinks      ProjectLink[]
  projectMembers    ProjectMember[]
  contacts          Contact[]
  activities        Activity[]
  quotes            Quote[]
  quoteItems        QuoteItem[]
  productCategories ProductCategory[]
  products          Product[]
  payments          Payment[]
  notifications     Notification[]
  notificationRecipients NotificationRecipient[]
  notificationPreferences NotificationPreference[]
  notificationDeliveryLogs NotificationDeliveryLog[]
  fileAttachments   FileAttachment[]
  files             File[]
  fileActivities    FileActivity[]
  auditLogs         AuditLog[]
  activityTimelines ActivityTimeline[]
  activityTimelineComments ActivityTimelineComment[]
  events            Event[]
  dynamicForms      DynamicForm[]
  workflowInstances WorkflowInstance[]
  workflowSteps     WorkflowStep[]
  workflowActions   WorkflowAction[]
  workflowComments  WorkflowComment[]
  workflowAssignments WorkflowAssignment[]
  workflowHistories WorkflowHistory[]
  workflowNotifications WorkflowNotification[]
  salaryStructures  SalaryStructure[]
  payrollCycles     PayrollCycle[]
  payrollEntries    PayrollEntry[]
  payslips          Payslip[]
  payrollEarnings   PayrollEarnings[]
  payrollDeductions PayrollDeduction[]
  taxDeclarations   TaxDeclaration[]
  form16s           Form16[]
  payrollConfigs    PayrollConfig[]
  jobOpenings       JobOpening[]
  candidates        Candidate[]
  interviews        Interview[]
  goalCycles        GoalCycle[]
  goals             Goal[]
  performanceReviews PerformanceReview[]
  importLogs        ImportLog[]

  @@index([status])
  @@index([createdAt])
  @@index([slug])
  @@index([code])
  @@index([subscriptionPlan])
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique
  description     String?
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         AppRole    @relation(fields: [roleId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
}

model UserRole {
  userId    Int
  roleId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AppRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
}

model Employee {
  id                    Int                 @id @default(autoincrement())
  name                  String
  phone                 String?
  position              String?
  salary                Float?
  email                 String?
  phoneNumber           String?
  department            String?
  designation           String?
  hireDate              DateTime?
  manager               String?
  leaveBalance          Int?
  status                String?
  pan                   String?
  shiftId               Int?
  organizationId        Int
  address               String?
  emergencyContact      String?
  emergencyContactPhone String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  attendances           Attendance[]
  dealAssignments       Deal[]              @relation("DealAssignee")
  shift                 Shift?              @relation(fields: [shiftId], references: [id])
  expenseClaims         Expense[]
  form16s               Form16[]
  goals                 Goal[]
  leadAssignments       Lead[]              @relation("LeadAssignee")
  leaveRequests         LeaveRequest[]
  payrollEntries        PayrollEntry[]
  payslips              Payslip[]
  performanceReviews    PerformanceReview[]
  projectMemberships    ProjectMember[]
  salaryStructures      SalaryStructure[]
  taskAssignments       Task[]              @relation("TaskAssignee")
  taxDeclarations       TaxDeclaration[]
  user                  User?               @relation("UserEmployee")
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignedProjects      Project[]           @relation("ProjectAssignedEmployees")

  @@index([organizationId])
}

model Shift {
  id                 Int          @id @default(autoincrement())
  name               String
  type               ShiftType
  startTime          String?
  endTime            String?
  requiredHours      Float        @default(8)
  gracePeriodMinutes Int          @default(15)
  rotationPattern    String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?
  organizationId        Int
  attendances        Attendance[]
  employees          Employee[]
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model Attendance {
  id            Int              @id @default(autoincrement())
  employeeId    Int
  shiftId       Int?
  date          DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  workingHours  Float?
  lateMinutes   Int              @default(0)
  overtimeHours Float            @default(0)
  requiredHours Float?
  isAutoClosed  Boolean          @default(false)
  isPaidLeave   Boolean?
  remarks       String?
  status        AttendanceStatus
  createdAt     DateTime         @default(now())
  deletedAt     DateTime?
  organizationId        Int
  employee      Employee         @relation(fields: [employeeId], references: [id])
  shift         Shift?           @relation(fields: [shiftId], references: [id])
  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@index([organizationId])
}

model Invoice {
  id            Int       @id @default(autoincrement())
  invoiceNo     String    @unique
  issueDate     DateTime?
  dueDate       DateTime?
  status        String    @default("DRAFT")
  customer      String?
  clientEmail   String?
  totalAmount   Float     @default(0)
  taxAmount     Float     @default(0)
  discount      Float     @default(0)
  paymentMethod String?
  notes         String?
  userId        Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  organizationId        Int
  user          User      @relation(fields: [userId], references: [id])
  payments      Payment[]
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model LedgerEntry {
  id          Int       @id @default(autoincrement())
  date        DateTime?
  description String?
  debit       Float     @default(0)
  credit      Float     @default(0)
  account     String?
  invoice     String?
  expense     String?
  balance     Float     @default(0)
  reference   String?
  userId      Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  organizationId        Int
  user        User      @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model Lead {
  id               Int            @id @default(autoincrement())
  name             String
  company          String?
  email            String?
  phone            String?
  status           String         @default("New")
  source           String?
  notes            String?
  leadOwner        String?
  contactedDate    DateTime?
  nextFollowUp     DateTime?
  assignedTo       String?
  assignedToId     Int?
  leadScore        Int?
  createdBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  organizationId        Int
  activities       Activity[]
  campaignLeads    CampaignLead[]
  deals            Deal[]
  assignedEmployee Employee?      @relation("LeadAssignee", fields: [assignedToId], references: [id])
  tasks            Task[]
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model CampaignLead {
  id              Int       @id @default(autoincrement())
  campaign        String
  engagementScore Int?
  sourceType      String?
  lastInteraction DateTime?
  status          String    @default("NEW")
  notes           String?
  leadId          Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  organizationId        Int
  lead            Lead?     @relation(fields: [leadId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model Timesheet {
  id        Int       @id @default(autoincrement())
  task      String
  project   String?
  date      DateTime
  hours     Float
  status    String    @default("PENDING")
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  organizationId        Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model Deal {
  id               Int        @id @default(autoincrement())
  title            String
  value            Float
  stage            String     @default("NEW")
  probability      Float?
  closeDate        DateTime?
  actualCloseDate  DateTime?
  contact          String?
  owner            String?
  assignedToId     Int?
  pipeline         String?
  leadId           Int?
  contactId        Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?
  organizationId        Int
  activities       Activity[]
  assignedEmployee Employee?  @relation("DealAssignee", fields: [assignedToId], references: [id])
  linkedContact    Contact?   @relation("ContactToDeals", fields: [contactId], references: [id])
  lead             Lead?      @relation(fields: [leadId], references: [id])
  quotes           Quote[]
  tasks            Task[]
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model Task {
  id               Int       @id @default(autoincrement())
  taskName         String
  project          String?
  projectId        Int?
  assignee         String?
  assignedToId     Int?
  assignedToUserId Int?
  assignedByUserId Int?
  dueDate          DateTime?
  priority         String?
  status           String    @default("PENDING")
  estimatedHours   Float?
  actualHours      Float?
  notes            String?
  submissionLink   String?
  reviewComment    String?
  leadId           Int?
  dealId           Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  organizationId        Int
  category         String?
  description      String?
  links            String?
  reviewedAt       DateTime?
  reviewedBy       Int?
  submissionNotes  String?
  assignedByUser   User?     @relation("TaskAssignedBy", fields: [assignedByUserId], references: [id])
  assignedEmployee Employee? @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedToUser   User?     @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id])
  deal             Deal?     @relation(fields: [dealId], references: [id])
  lead             Lead?     @relation(fields: [leadId], references: [id])
  projectRef       Project?  @relation("ProjectTasks", fields: [projectId], references: [id])
  reviewedByUser   User?     @relation("TaskReviewedBy", fields: [reviewedBy], references: [id])
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model LeaveRequest {
  id            Int       @id @default(autoincrement())
  employeeId    Int?
  startDate     DateTime
  endDate       DateTime
  leaveType     String
  reason        String?
  status        String    @default("PENDING")
  isPaid        Boolean   @default(true)
  appliedOn     DateTime?
  approvedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  approvalTrail Json?
  organizationId        Int
  employee      Employee? @relation(fields: [employeeId], references: [id])
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model TicketType {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  color     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  tickets   Ticket[]
}

model Ticket {
  id           Int         @id @default(autoincrement())
  event        String?
  customer     String?
  price        Float?
  status       String      @default("RESERVED")
  purchaseDate DateTime?
  qrCode       String?
  notes        String?
  ticketTypeId Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  organizationId        Int
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model FormSubmission {
  id             Int       @id @default(autoincrement())
  form           String
  submittedBy    String?
  submissionDate DateTime?
  data           String?
  status         String    @default("SUBMITTED")
  reviewer       String?
  reviewDate     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  organizationId        Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model MarketingCampaign {
  id             Int       @id @default(autoincrement())
  campaignName   String
  channel        String?
  startDate      DateTime?
  endDate        DateTime?
  objective      String?
  budget         Float?
  status         String    @default("PLANNED")
  targetAudience String?
  createdBy      String?
  campaignOwner  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  organizationId        Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model Expense {
  id                      Int       @id @default(autoincrement())
  expenseDate             DateTime?
  category                String?
  description             String?
  amount                  Float?
  currency                String?
  receiptImage            String?
  approvedBy              String?
  status                  String    @default("PENDING")
  employeeId              Int?
  submittedByUserId       Int?
  managerApprovalByUserId Int?
  hrApprovalByUserId      Int?
  approvedAt              DateTime?
  rejectedAt              DateTime?
  rejectionReason         String?
  approvalTrail           Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?
  organizationId        Int
  employee                Employee? @relation(fields: [employeeId], references: [id])
  hrApprovalByUser        User?     @relation("ExpenseHrApprovedBy", fields: [hrApprovalByUserId], references: [id])
  managerApprovalByUser   User?     @relation("ExpenseManagerApprovedBy", fields: [managerApprovalByUserId], references: [id])
  submittedByUser         User?     @relation("ExpenseSubmittedBy", fields: [submittedByUserId], references: [id])
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model Project {
  id                Int              @id @default(autoincrement())
  projectName       String
  projectCode       String?
  startDate         DateTime?
  endDate           DateTime?
  manager           String?
  managerId         Int?
  status            String           @default("PLANNED")
  budget            Float?
  description       String?
  client            String?
  projectLead       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  organizationId        Int
  managerUser       User?            @relation("ProjectManager", fields: [managerId], references: [id])
  links             ProjectLink[]
  members           ProjectMember[]
  messages          ProjectMessage[]
  tasks             Task[]           @relation("ProjectTasks")
  assignedEmployees Employee[]       @relation("ProjectAssignedEmployees")
  coManagers        User[]           @relation("ProjectCoManagers")
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model ProjectMessage {
  id        String   @id @default(cuid())
  projectId Int
  senderId  Int
  content   String
  createdAt DateTime @default(now())
  organizationId        Int
  project   Project  @relation(fields: [projectId], references: [id])
  sender    User     @relation("ProjectMessageSender", fields: [senderId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([projectId])
  @@index([senderId])
  @@index([organizationId])
}

model ProjectLink {
  id          Int       @id @default(autoincrement())
  projectId   Int
  title       String
  url         String
  createdById Int
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  organizationId        Int
  createdBy   User      @relation(fields: [createdById], references: [id])
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([projectId])
  @@index([organizationId])
}

model ProjectMember {
  projectId  Int
  employeeId Int
  role       String?
  joinedAt   DateTime @default(now())
  organizationId        Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([projectId, employeeId])
  @@index([organizationId])
}

model Contact {
  id            Int        @id @default(autoincrement())
  contactName   String
  email         String?
  phoneNumber   String?
  company       String?
  jobTitle      String?
  leadSource    String?
  address       String?
  website       String?
  linkedin      String?
  contactStatus String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
  organizationId        Int
  activities    Activity[]
  deals         Deal[]     @relation("ContactToDeals")
  quotes        Quote[]
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model Activity {
  id          Int          @id @default(autoincrement())
  type        ActivityType
  description String
  userId      Int
  leadId      Int?
  dealId      Int?
  contactId   Int?
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?
  contact     Contact?     @relation(fields: [contactId], references: [id])
  deal        Deal?        @relation(fields: [dealId], references: [id])
  lead        Lead?        @relation(fields: [leadId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  organizationId        Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model Event {
  id            Int       @id @default(autoincrement())
  eventName     String
  eventCode     String?
  startDateTime DateTime?
  endDateTime   DateTime?
  location      String?
  organizer     String?
  status        String?
  capacity      Int?
  description   String?
  eventType     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  organizationId        Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model DynamicForm {
  id           Int       @id @default(autoincrement())
  formName     String
  formCode     String?
  description  String?
  createdBy    String?
  status       String?
  formType     String?
  targetModule String?
  createdOn    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  organizationId        Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model Quote {
  id        Int         @id @default(autoincrement())
  dealId    Int
  contactId Int
  total     Float
  status    String      @default("DRAFT")
  validTill DateTime
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  organizationId        Int
  contact   Contact     @relation(fields: [contactId], references: [id])
  deal      Deal        @relation(fields: [dealId], references: [id])
  items     QuoteItem[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model QuoteItem {
  id        Int       @id @default(autoincrement())
  quoteId   Int
  name      String
  quantity  Int
  price     Float
  deletedAt DateTime?
  organizationId        Int
  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model ProductCategory {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  organizationId        Int
  products  Product[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model Product {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  price       Float
  sku         String?
  categoryId  Int?
  taxRate     Float?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  deletedAt   DateTime?
  organizationId        Int
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
}

model Payment {
  id            Int       @id @default(autoincrement())
  invoiceId     Int
  amount        Float
  paymentMethod String
  transactionId String?
  paymentDate   DateTime
  status        String
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  organizationId        Int
  invoice       Invoice   @relation(fields: [invoiceId], references: [id])
