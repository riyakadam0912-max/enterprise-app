# Test Environment - All external integrations disabled
NODE_ENV=test

# Test Database
DATABASE_URL="postgresql://postgres:riya123@localhost:5432/enterprise_db_test"

# API
PORT=3001

# JWT (for testing only - these are not production secrets)
JWT_SECRET="test-secret-key-for-jwt"
JWT_ACCESS_SECRET="test-access-secret-key"
JWT_REFRESH_SECRET="test-refresh-secret-key"
JWT_ISSUER="http://localhost:3001"
JWT_AUDIENCE="enterprise-api"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend URLs
FRONTEND_URL="http://localhost:3001"
FRONTEND_URLS="http://127.0.0.1:3001"
FRONTEND_ORIGIN="http://localhost:3001"
FRONTEND_ORIGINS="http://127.0.0.1:3001"

# Redis
REDIS_ENABLED=false

# Realtime / WebSocket
# In test mode we allow in-process Socket.IO for unit tests; Redis adapter not required
WEBSOCKET_ENABLED=true

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Mail provider - NONE in tests (no real email sending)
EMAIL_PROVIDER=NONE

# CRITICAL: Disable SMTP verification in tests to prevent async connection attempts
SMTP_VERIFY_ON_STARTUP=false

# SMTP config (not used in test mode, but kept for reference)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=test@example.com
SMTP_PASS=test-password
SMTP_FROM_EMAIL=noreply@enterprise.local
SMTP_FROM_NAME=Enterprise ERP

# Logging
LOG_LEVEL=error
