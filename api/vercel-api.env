DATABASE_URL=postgresql://postgres:postgres@db.example.com:5432/enterprise_db

PORT=3000
REDIS_ENABLED=false

JWT_SECRET=replace-with-secure-shared-secret
JWT_ACCESS_SECRET=replace-with-secure-access-secret
JWT_REFRESH_SECRET=replace-with-secure-refresh-secret

JWT_ISSUER=https://enterprise-app-1phv.vercel.app
JWT_AUDIENCE=enterprise-api
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=https://enterprise-app-web-orcin.vercel.app
FRONTEND_URLS=https://enterprise-app-web-orcin.vercel.app,https://enterprise-app-1phv.vercel.app
FRONTEND_ORIGIN=https://enterprise-app-web-orcin.vercel.app
FRONTEND_ORIGINS=https://enterprise-app-web-orcin.vercel.app,https://enterprise-app-1phv.vercel.app

COOKIE_SECURE=true
COOKIE_SAME_SITE=none

EMAIL_PROVIDER=nodemailer

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password

SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Enterprise ERP
SMTP_VERIFY_ON_STARTUP=false
