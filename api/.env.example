# File storage. With S3 credentials configured, S3 is selected automatically.
FILE_STORAGE_PROVIDER=s3
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=eu-north-1
AWS_S3_PREFIX=assets/riya_erp
AWS_S3_ACCESS_KEY_ID=your-access-key
AWS_S3_SECRET_ACCESS_KEY=your-secret-key
# Development settings
# These values are local examples only and are not intended for production.
# Production secrets must be supplied by the deployment environment and must never be committed.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enterprise_db"
PORT=3000
# Bind to all interfaces for local mobile-device testing. Use 127.0.0.1 in production unless a reverse proxy requires otherwise.
HOST=0.0.0.0
# Optional, persistent hosts only: comma-separated trusted reverse-proxy CIDRs.
# Keep empty for direct connections; never use blanket trust.
TRUSTED_PROXY_CIDRS=

FRONTEND_URL="http://localhost:3001"
FRONTEND_URLS="http://127.0.0.1:3001"
FRONTEND_ORIGIN="http://localhost:3001"
FRONTEND_ORIGINS="http://127.0.0.1:3001"

# Redis is optional. Without it: development uses memory, production uses PostgreSQL.
REDIS_ENABLED=false
# Explicit queue flag; false keeps deal workflows inline even with a Redis URL.
# Persistent workers are always disabled on Vercel.
REDIS_QUEUE_ENABLED=false
# Optional shared authentication counter store (TCP URL, not a REST URL).
# RATE_LIMIT_REDIS_URL=rediss://user:password@redis-host:6379
# REDIS_URL is the fallback auth URL and the queue URL when queues are enabled.
# REDIS_URL=rediss://user:password@redis-host:6379
# Legacy host configuration is used when REDIS_ENABLED=true and no URL is set.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Realtime is process-local; there is no Socket.IO Redis adapter in this project.
# Keep disabled on Vercel. Enabling Redis does not enable cross-instance broadcasts.
# A single persistent Node host may explicitly enable WebSockets.
WEBSOCKET_ENABLED=false

# Local placeholders only. Production access/refresh secrets must be separate,
# non-placeholder values of at least 32 random bytes each.
JWT_SECRET="replace-with-secure-shared-secret"
JWT_ACCESS_SECRET="replace-with-secure-access-secret"
JWT_REFRESH_SECRET="replace-with-secure-refresh-secret"
JWT_ISSUER="http://localhost:3000"
JWT_AUDIENCE="enterprise-api"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

EMAIL_PROVIDER="NONE"

# ============================================================================
# PRODUCTION BOOTSTRAP CONFIGURATION
# ============================================================================
#
# Required for production database initialization via: npm run seed:production
#
# BOOTSTRAP ENVIRONMENT VARIABLES:
# ================================
#
# BOOTSTRAP_ORGANIZATION_CODE
#   Default: "PROD"
#   Description: Unique organization identifier code for database lookups
#   Example: "PROD", "MY-ORG", "CLIENT-001"
#
# BOOTSTRAP_ORGANIZATION_NAME
#   Default: "Production Organization"
#   Description: Display name for the organization
#   Example: "Acme Corporation", "Tech Startup Inc."
#
# BOOTSTRAP_ORGANIZATION_SLUG
#   Default: "production"
#   Description: URL-friendly identifier (used in subdomain/path routing)
#   Example: "acme-corp", "tech-startup"
#   Note: Must be unique across all organizations
#
# BOOTSTRAP_ORGANIZATION_TIMEZONE
#   Default: "Asia/Kolkata"
#   Description: Organization default timezone (IANA timezone)
#   Examples: "Asia/Kolkata", "America/New_York", "Europe/London"
#
# BOOTSTRAP_ORGANIZATION_CURRENCY
#   Default: "INR"
#   Description: Organization default currency code (ISO 4217)
#   Examples: "INR", "USD", "EUR", "GBP"
#
# BOOTSTRAP_SUPER_ADMIN_EMAIL
#   Required: YES
#   Description: Email address of the platform super admin
#   Example: "admin@company.com"
#   Note: Cannot be changed after bootstrap
#
# BOOTSTRAP_SUPER_ADMIN_PASSWORD
#   Required: YES
#   Description: Initial password for platform super admin
#   Constraints:
#     - Must be at least 8 characters
#     - Must NOT be a placeholder value
#     - Must NOT be any of: replace-with-secure-*, example, dummy, password, admin123, etc.
#   Example: "S0m3Str0ng!P@ssw0rd" (do not commit; use env vars only)
#
# BOOTSTRAP_ADMIN_EMAIL (OPTIONAL)
#   Default: Not set (skipped if empty)
#   Description: Email for organization admin (belongs to production org)
#   Example: "org-admin@company.com"
#   Note: Requires BOOTSTRAP_ADMIN_PASSWORD if this is set
#
# BOOTSTRAP_ADMIN_PASSWORD (OPTIONAL)
#   Default: Not set (skipped if empty)
#   Description: Initial password for organization admin
#   Constraints: Same as BOOTSTRAP_SUPER_ADMIN_PASSWORD
#   Note: Required only if BOOTSTRAP_ADMIN_EMAIL is set
#
# BOOTSTRAP SAFETY CHECKS:
# ========================
# - Bootstrap must run with NODE_ENV=production
# - All passwords are validated against a forbidden list of placeholders
# - No destructive operations (no TRUNCATE, DELETE, RESET IDENTITY)
# - Fully idempotent (safe to run multiple times)
# - Existing data is never overwritten
#
# EXAMPLE PRODUCTION BOOTSTRAP COMMAND:
# =====================================
# export NODE_ENV=production
# export DATABASE_URL="postgresql://user:pass@prod-db:5432/enterprise_db"
# export BOOTSTRAP_ORGANIZATION_CODE="PROD"
# export BOOTSTRAP_ORGANIZATION_NAME="Acme Corporation"
# export BOOTSTRAP_ORGANIZATION_SLUG="acme"
# export BOOTSTRAP_ORGANIZATION_TIMEZONE="Asia/Kolkata"
# export BOOTSTRAP_ORGANIZATION_CURRENCY="INR"
# export BOOTSTRAP_SUPER_ADMIN_EMAIL="admin@acme.com"
# export BOOTSTRAP_SUPER_ADMIN_PASSWORD="ActualSecurePassword123!@#"
# export BOOTSTRAP_ADMIN_EMAIL="org-admin@acme.com"
# export BOOTSTRAP_ADMIN_PASSWORD="AnotherSecurePassword456!@#"
#
# npm run seed:production
#
# NOTE: All passwords and secrets must come from secure environment variables
# and MUST NEVER be committed to source control.

# Production values must be supplied outside source control.
# - DATABASE_URL=<Hostinger PostgreSQL connection string>
# - JWT_ACCESS_SECRET=<strong random secret>
# - JWT_REFRESH_SECRET=<strong random secret>
# - JWT_ISSUER=<production API origin>
# - JWT_AUDIENCE=<production API audience>
# - FRONTEND_URL=<production frontend origin>
# - FRONTEND_URLS=<comma-separated production frontend origins>
# - COOKIE_SECURE=true
# - COOKIE_SAME_SITE=lax|none (must match deployment topology)
# - EMAIL_PROVIDER=NODEMAILER
# - REDIS_ENABLED=false
# - Do not commit real credentials or sandbox values here.

# Example production provider configuration (do not fill with real credentials here):
# EMAIL_PROVIDER="RESEND"
# RESEND_API_KEY="re_xxx"
# RESEND_FROM_EMAIL="noreply@yourcompany.com"
# RESEND_FROM_NAME="Your Company ERP"

# Additional provider examples are allowed for docs only and must not be committed with real values:
# EMAIL_PROVIDER="SENDGRID"
# SENDGRID_API_KEY="SG_xxx"
# SENDGRID_FROM_EMAIL="noreply@yourcompany.com"
# SENDGRID_FROM_NAME="Your Company ERP"


# EMAIL_PROVIDER="SES"
# AWS_SES_REGION="us-east-1"
# AWS_SES_ACCESS_KEY_ID=""
# AWS_SES_SECRET_ACCESS_KEY=""
# AWS_SES_FROM_EMAIL="noreply@yourcompany.com"
# AWS_SES_FROM_NAME="Your Company ERP"

# BOOTSTRAP_ADMIN_PASSWORD=<set externally>
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=<set externally>
# Organization-local dates before this use legacy attendance; dates from this use task time.
ATTENDANCE_FLEXIBLE_TASK_CUTOVER_DATE=2026-10-17
