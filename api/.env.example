# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/enterprise_db"

# API
PORT=3000

# Frontend CORS (single origin + optional CSV list)
FRONTEND_URL="http://localhost:3001"
FRONTEND_URLS="http://127.0.0.1:3001,http://192.168.1.43:3001"
# Legacy aliases still supported in code: FRONTEND_ORIGIN, FRONTEND_ORIGINS

# JWT
# Fallback chain for access token secret: JWT_ACCESS_SECRET -> JWT_SECRET -> internal default
JWT_SECRET="replace-with-secure-shared-secret"
JWT_ACCESS_SECRET="replace-with-secure-access-secret"
JWT_REFRESH_SECRET="replace-with-secure-refresh-secret"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Mail provider
# Preferred for local development: NONE
EMAIL_PROVIDER="NONE"
MAIL_FROM="noreply@localhost"

# Preferred production provider: RESEND
# EMAIL_PROVIDER="RESEND"
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="noreply@yourcompany.com"
RESEND_FROM_NAME="Your Company ERP"

# Alternative: SENDGRID
# EMAIL_PROVIDER="SENDGRID"
# SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"
# SENDGRID_FROM_EMAIL="noreply@yourcompany.com"
# SENDGRID_FROM_NAME="Your Company ERP"
# Note: the SendGrid sender identity must be verified in the SendGrid dashboard.

# Alternative: SES
# EMAIL_PROVIDER="SES"
# AWS_SES_REGION="us-east-1"
# AWS_SES_ACCESS_KEY_ID="your_aws_access_key"
# AWS_SES_SECRET_ACCESS_KEY="your_aws_secret_key"
# AWS_SES_FROM_EMAIL="noreply@yourcompany.com"
# AWS_SES_FROM_NAME="Your Company ERP"

# Alternative: NODEMAILER (SMTP)
# EMAIL_PROVIDER="NODEMAILER"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="yourgmail@gmail.com"
# SMTP_PASS="your_gmail_app_password"
# SMTP_FROM_EMAIL="yourgmail@gmail.com"
# SMTP_FROM_NAME="Enterprise ERP"
# SMTP_VERIFY_ON_STARTUP=true

# Bootstrap passwords (first-run only)
# If not set, a cryptographically random password will be generated and logged once.
# BOOTSTRAP_ADMIN_PASSWORD="your-strong-admin-password"
# BOOTSTRAP_SUPER_ADMIN_PASSWORD="your-strong-super-admin-password"
