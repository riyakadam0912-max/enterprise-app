<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
  <tr>
    <td style="padding:16px;border-radius:8px;background:{{#if (eq type 'success')}}#dcfce7{{else if (eq type 'warning')}}#fef3c7{{else if (eq type 'danger')}}#fee2e2{{else}}#e0f2fe{{/if}};color:#0f172a;">
      <div style="font-weight:bold;">{{title}}</div>
      <div style="margin-top:8px;">{{body}}</div>
    </td>
  </tr>
</table>
