{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "maxWorkers": 1,
  "testTimeout": 120000,
  "verbose": true,
  "useStderr": true,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["dotenv/config"],
  "setupFilesAfterEnv": ["<rootDir>/setup.ts"],
  "modulePaths": ["<rootDir>/../src"],
  "moduleDirectories": ["node_modules", "<rootDir>"]
}
