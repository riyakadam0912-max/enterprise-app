# Test-only configuration. Copy to .env.test for local integration tests.
# Never commit real credentials or production connection strings.
NODE_ENV=test
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enterprise_test"
PORT=3002

JWT_SECRET="test-only-shared-secret-not-for-production"
JWT_ACCESS_SECRET="test-only-access-secret-not-for-production"
JWT_REFRESH_SECRET="test-only-refresh-secret-not-for-production"
JWT_ISSUER="http://localhost:3002"
JWT_AUDIENCE="enterprise-api-test"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="1d"

FRONTEND_URL="http://localhost:3001"
FRONTEND_URLS="http://127.0.0.1:3001"
FRONTEND_ORIGIN="http://localhost:3001"
FRONTEND_ORIGINS="http://127.0.0.1:3001"

REDIS_ENABLED=false
WEBSOCKET_ENABLED=false
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

EMAIL_PROVIDER=NONE
SMTP_VERIFY_ON_STARTUP=false
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="test@example.com"
SMTP_FROM_NAME="Enterprise ERP Test"
LOG_LEVEL=error
