{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": ".",
  "installCommand": "npm ci",
  "framework": null,
  "redirects": [
    { "source": "/", "destination": "/api/v1/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    }
  }
}
